# ============================================================
# Open Agent Hackathon 2026, project settings
# Copy this file to .env and fill in real values.
# .env is gitignored, never commit it.
# ============================================================

# --- DATA · Zetaris (local install) --------------------------
# API key is created in the Zetaris web UI at http://localhost:3000
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
# Username/password are only needed to download the API specification
ZETARIS_USERNAME=your-sign-in-email
ZETARIS_PASSWORD=your-sign-in-password

# --- POWER · Nemotron route (smoke_test.py + agent llm.py) ---
# Pick ONE route and take ALL THREE values from that same route.
#
# Option A, Meterless Nightshift (primary provider for the demo):
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=your-nightshift-runtime-token
NEMOTRON_MODEL=the-nemotron-model-pinned-in-your-nightshift-lane
#
# Option B, NVIDIA free API (secondary route):
#   MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
#   MODEL_API_KEY=your-nvapi-key
#   NEMOTRON_MODEL=exact-model-id-from-build.nvidia.com

# --- POWER · Meterless Nightshift connection (your app) ------
# Copy the URL and Runtime token from Nightshift's Console (top right).
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-real-nightshift-runtime-token
METERLESS_MODEL=meterless/auto
